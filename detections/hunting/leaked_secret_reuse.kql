// Hunting: the same secret (same HMAC fingerprint) seen in several sessions or hosts.
// Fingerprints are HMAC-SHA256 with a per-install key, so this only correlates within one
// installation (one key). Nobody can recover the secret from the log.
GatehouseEvents_CL
| where EventType == "detection" and DetectorId == "args.secrets"
| extend Fingerprint = tostring(Details.MatchFingerprint)
| where isnotempty(Fingerprint)
| summarize FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated),
            Sessions = dcount(AgentSessionId), Tools = make_set(strcat(ServerName, "/", ToolName), 20),
            Actions = make_set(Action, 5), Masked = take_any(MatchSummary)
    by Host, RuleId, Fingerprint
| order by Sessions desc
